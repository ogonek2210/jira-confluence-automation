{ 
  "servers": { 
    "echo-windows": { 
      "command": "powershell", 
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/mcp-echo.ps1"] 
    },
    "time-windows": { 
      "command": "powershell", 
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/mcp-time.ps1"] 
    },
    "github": { 
      "type": "http", 
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "chrome-devtools": {
      "command": "npx.cmd",
      "args": ["-y", "chrome-devtools-mcp@latest"]
    }
  }  
}  